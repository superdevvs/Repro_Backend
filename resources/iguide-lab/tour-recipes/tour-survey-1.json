                                                    "vMax": {
                                                        "type": "number",
                                                        "minimum": 0,
                                                        "maximum": 1
                                                    }
                                                }
                                            },
                                            "confidence": {
                                                "type": "number",
                                                "minimum": 0,
                                                "maximum": 1
                                            },
                                            "glassOrMirror": {
                                                "type": "boolean"
                                            },
                                            "touchGroup": {
                                                "type": "integer",
                                                "minimum": 0,
                                                "maximum": 12
                                            }
