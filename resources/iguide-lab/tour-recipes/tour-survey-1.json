                                                    "uMax": {
                                                        "type": "number",
                                                        "minimum": 0,
                                                        "maximum": 1
                                                    },
                                                    "vMin": {
                                                        "type": "number",
                                                        "minimum": 0,
                                                        "maximum": 1
