APP_NAME="REPro Backend"
APP_ENV=local
APP_KEY=base64:your-app-key-here
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

BROADCAST_DRIVER=log
CACHE_DRIVER=file
# Optional dedicated shared store for Nominatim's application-wide throttle.
# Leave blank to use the default cache store; database, file, or Redis support locks.
NOMINATIM_THROTTLE_CACHE_STORE=
NOMINATIM_MIN_INTERVAL_MS=1000
NOMINATIM_LOCK_SECONDS=20
NOMINATIM_LOCK_WAIT_SECONDS=15
NOMINATIM_REQUEST_TIMEOUT_SECONDS=10
NOMINATIM_USER_AGENT="REPRO Dashboard App/1.0 (contact@reprophotos.com)"
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

FAL_KEY=
FAL_MODEL=fal-ai/wan-pro/image-to-video
FAL_IMAGE_MODEL=fal-ai/flux-kontext/dev
FAL_TEST_MODE=true
AI_EDITING_PROVIDER=fal

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email - all mail goes through CakeMail REST API (no SMTP)
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@reprophotos.com"
MAIL_FROM_NAME="REPro Photos"
CAKEMAIL_USERNAME=your-cakemail-username
CAKEMAIL_PASSWORD=your-cakemail-password
CAKEMAIL_SENDER_ID=your-sender-id
CAKEMAIL_LIST_ID=your-list-id
CAKEMAIL_BASE_URL=https://your-cakemail-host

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare R2 media storage (S3-compatible). Backs the "media" filesystem disk.
# R2_ENDPOINT example: https://<accountid>.r2.cloudflarestorage.com
# R2_PUBLIC_URL is the public CDN custom domain, e.g. https://cdn.reprodashboard.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_DEFAULT_REGION=auto
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_URL=
R2_USE_PATH_STYLE_ENDPOINT=false

# Media migration feature flags (Dropbox/local -> R2 phased cutover). All OFF
# until R2 is provisioned and verified. See config/media.php.
MEDIA_DUAL_WRITE=false
MEDIA_READ_FROM_R2=false
MEDIA_R2_ONLY=false
MEDIA_TEMPORARY_URL_TTL=900

VITE_APP_NAME=""

SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:3000,127.0.0.1:5173,127.0.0.1:3000
SESSION_DOMAIN=localhost

# Telnyx SMS Integration
TELNYX_API_KEY=
# Ed25519 base64 public key from Telnyx Portal -> Keys & Credentials -> Public Key (NOT the API key)
TELNYX_PUBLIC_KEY=
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_FROM_NUMBER=+18883426998
TELNYX_PHONE_NUMBER_ID=
TELNYX_DEFAULT_LABEL="Telnyx SMS"
TELNYX_API_BASE=https://api.telnyx.com/v2
TELNYX_WEBHOOK_TOLERANCE_SECONDS=300

# Direct Telnyx voice agent. Canary mode blocks every outbound destination that
# is not listed in VOICE_CANARY_NUMBERS (comma-separated E.164 numbers).
VOICE_PROVIDER=telnyx
VOICE_CANARY_MODE=true
VOICE_CANARY_NUMBERS=
TELNYX_VOICE_ENABLED=false
TELNYX_VOICE_ASSISTANT_ID=
TELNYX_VOICE_CONNECTION_ID=
TELNYX_VOICE_WEBHOOK_URL=
TELNYX_VOICE_RECORDING_ENABLED=true
TELNYX_VOICE_SUPPORT_HANDOFF_NUMBER=
TELNYX_VOICE_ALLOW_UNVERIFIED_TRANSFER=true
TELNYX_VOICE_DISCLOSURE_TEXT="Hi, this is Robbie, RePro's AI assistant. With your permission, this call can be recorded and transcribed to help manage your booking. Say yes to consent, no to continue without recording, or say human to reach a person."
TELNYX_TOOL_BRIDGE_SECRET=
TELNYX_TOOL_BRIDGE_BASE_URL=https://api.reprodashboard.com/api/telnyx-ai/tools

# Vapi voice AI over Telnyx carrier/SIP
VAPI_API_KEY=
VAPI_API_BASE=https://api.vapi.ai
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
VAPI_SERVER_SECRET=
VAPI_WEBHOOK_URL=

# QA outbound test number used by QA/test scripts (e.g. the SMS check).
# Must be a valid, owned E.164 number. Leave blank to use the documented default
# (+12025550100, the reserved 555-01xx test range). Override per environment.
QA_OUTBOUND_TEST_NUMBER=

# Telnyx AI SMS Agent (Phase B)
TELNYX_AI_SMS_ENABLED=false
TELNYX_AI_TAKEOVER_PAUSE_MINUTES=120
TELNYX_AI_SESSION_IDLE_TTL_MINUTES=1440
TELNYX_AI_PENDING_ACTION_TTL_MINUTES=10
TELNYX_AI_SMS_MAX_SEGMENTS=3
TELNYX_AI_SMS_MAX_REPLIES_PER_HOUR=20
TELNYX_AI_VERIFICATION_TTL_MINUTES=10

# Google Calendar Integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=

# iGUIDE Integration
# Portal v1 API (manage.youriguide.com/api/v1) — preferred. Needed for
# outbound sync (fetch iGuide by property/address, pull deliverables).
IGUIDE_APP_ID=
IGUIDE_APP_TOKEN=
# Legacy api.iguide.com basic-auth — used as a fallback if Portal not configured.
IGUIDE_API_USERNAME=
IGUIDE_API_PASSWORD=
IGUIDE_API_KEY=
IGUIDE_API_URL=https://manage.youriguide.com/api/v1
IGUIDE_LEGACY_API_URL=https://api.iguide.com
# Public URL the iGuide Portal should POST ready events to.
# Defaults to {APP_URL}/iguide_webhook.php if unset.
IGUIDE_WEBHOOK_URL=
# Optional shared secret used to verify X-Iguide-Signature (HMAC-SHA256) on webhook bodies.
IGUIDE_WEBHOOK_SECRET=

# CubiCasa Integrate API v3
# Production: app.cubi.casa, Staging: qa-customers.cubi.casa
CUBICASA_API_KEY=
CUBICASA_ENVIRONMENT=production
# Optional override; defaults are picked from CUBICASA_ENVIRONMENT.
CUBICASA_BASE_URL=
# REQUIRED to create orders. Must name a user in our CubiCasa company account —
# the shared ops mailbox photographers work out of. Orders 400 without it.
CUBICASA_OWNER_EMAIL=
# Public URL CubiCasa should POST order-status events to.
# Defaults to {APP_URL}/cubicasa_webhook.php if unset.
CUBICASA_WEBHOOK_URL=
# Optional shared secret used to verify webhook signatures (header TBD on first delivery).
CUBICASA_WEBHOOK_SECRET=

# MyMarketingMatters (MMM) Punchout/SSO Integration
MMM_ENABLED=true
MMM_DUNS=Wqsw5cPn3Neo9Blz
MMM_SHARED_SECRET=
MMM_USER_AGENT=REPro Photos
MMM_PUNCHOUT_URL=https://repro.mymarketingmatters.com/punchoutsetup.asp
MMM_TEMPLATE_EXTERNAL_NUMBER=
MMM_DEPLOYMENT_MODE=test
MMM_START_POINT=Category
MMM_TO_IDENTITY=
MMM_SENDER_IDENTITY=
MMM_URL_RETURN=http://127.0.0.1:8000/api/integrations/mmm/return
MMM_RETURN_REDIRECT_URL=
MMM_TIMEOUT=20

# ClamAV (clamd) upload virus scanning
# Prefer a unix socket when clamd runs on the same host; otherwise use TCP host/port.
CLAMAV_SOCKET=
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_CONNECT_TIMEOUT=10
CLAMAV_READ_TIMEOUT=60
CLAMAV_CHUNK_SIZE=8192
