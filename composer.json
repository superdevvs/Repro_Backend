{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "ext-sodium": "*",
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.15.2",
        "intervention/image": "^3.11",
        "laravel/framework": "^12.64.0",
        "laravel/sanctum": "^4.1",
        "laravel/tinker": "^2.10.1",
        "league/flysystem-aws-s3-v3": "^3.35.2",
        "pel/pel": "^1.0",
        "stripe/stripe-php": "^19.4"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.56"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan storage:link --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"npm run dev\" --names='server,queue,vite'"
        ],
        "dev:fast": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -k -c \"#93c5fd,#a7f3d0,#a7f3d0,#a7f3d0,#a7f3d0,#fdba74\" \"node scripts/dev-proxy.mjs 8000 8001 8002 8003 8004\" \"php artisan serve --port=8001\" \"php artisan serve --port=8002\" \"php artisan serve --port=8003\" \"php artisan serve --port=8004\" \"npm run dev\" --names='proxy,web1,web2,web3,web4,vite'"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php -d memory_limit=2G artisan test --fail-on-warning --fail-on-risky --fail-on-skipped --fail-on-phpunit-deprecation"
        ],
        "quality": [
            "@composer validate --strict",
            "@composer audit --locked",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
