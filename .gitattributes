* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore

# Environment files and local operational artifacts never belong in releases.
.env export-ignore
.env.* export-ignore
.env.example -export-ignore
*.pem export-ignore
*.key export-ignore
*.p12 export-ignore
*.pfx export-ignore
*.jks export-ignore
/output export-ignore
/quarantine* export-ignore
/bootstrap/cache/*.php export-ignore
