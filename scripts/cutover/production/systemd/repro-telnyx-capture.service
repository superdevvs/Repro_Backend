# Installed as /etc/systemd/system/repro-telnyx-capture.service and enabled
# (systemctl enable --now repro-telnyx-capture.service). It runs at all
# times; nginx sends Telnyx to it only while the cutover hold is in force.
#
# Its own PHP-FPM master, independent of php8.3-fpm.service: the freeze
# drains and stops the app's FPM, and this unit must keep answering. Never
# tie it to that unit (PartOf, BindsTo, Requires) and never list it in the
# host config's drain_fpm, stop_workers or writer_processes.
[Unit]
Description=RePro Telnyx capture while the cutover hold is in force (own PHP-FPM, no database)
Documentation=file:///opt/repro-cutover-fence/production/README.md
# The socket directory /run/repro-telnyx-capture comes from
# /etc/tmpfiles.d/repro-cutover-fence.conf.
After=local-fs.target systemd-tmpfiles-setup.service
Before=nginx.service

[Service]
Type=notify
ExecStart=/usr/sbin/php-fpm8.3 --nodaemonize --fpm-config /etc/repro-telnyx-capture/php-fpm.conf
ExecReload=/bin/kill -USR2 $MAINPID
Restart=always
RestartSec=2
PrivateTmp=true
ProtectSystem=full
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
