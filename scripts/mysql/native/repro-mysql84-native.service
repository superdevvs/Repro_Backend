[Unit]
Description=Isolated native RePro MySQL 8.4.13
After=local-fs.target
RequiresMountsFor=/opt/repro-mysql84-native /var/lib/repro-mysql84-native /var/log/repro-mysql84-native
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=repro-mysql84-native
Group=repro-mysql84-native
UMask=0077
RuntimeDirectory=repro-mysql84-native
RuntimeDirectoryMode=0750
WorkingDirectory=/var/lib/repro-mysql84-native
# Fixed privileged operation on the new runtime directory only. mysqld itself
# never inherits www-data access to unrelated application files.
ExecStartPre=+/usr/bin/chgrp www-data /run/repro-mysql84-native
ExecStartPre=/usr/bin/python3 -I /opt/repro-mysql84-native/ops/native_mysql.py verify-start
ExecStart=/opt/repro-mysql84-native/mysql-8.4.13/bin/mysqld --defaults-file=/etc/repro-mysql84-native/mysql.cnf
ExecStartPost=/usr/bin/python3 -I /opt/repro-mysql84-native/ops/native_mysql.py wait-ready
Restart=on-failure
RestartSec=10
TimeoutStartSec=180
TimeoutStopSec=180
KillSignal=SIGTERM
MemoryHigh=6G
MemoryMax=8G
MemorySwapMax=0
CPUQuota=400%
IOWeight=100
TasksMax=512
LimitNOFILE=65535
LimitCORE=0
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
ReadWritePaths=/var/lib/repro-mysql84-native /var/log/repro-mysql84-native /run/repro-mysql84-native
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100

[Install]
WantedBy=multi-user.target
