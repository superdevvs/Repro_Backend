[Unit]
Description=Rotate authenticated isolated native MySQL logs
After=repro-mysql84-native.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
StateDirectory=repro-mysql84-native-logrotate
StateDirectoryMode=0700
# Required: logrotate can shift old archives before an in-config prerotate fails.
ExecStartPre=/usr/bin/python3 -I /opt/repro-mysql84-native/ops/native_mysql.py check
ExecStart=/usr/sbin/logrotate --state /var/lib/repro-mysql84-native-logrotate/status /etc/repro-mysql84-native/logrotate.conf
TimeoutStartSec=120
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/log/repro-mysql84-native /var/lib/repro-mysql84-native-logrotate
