[mysqld]
basedir=/opt/repro-mysql84-native/mysql-8.4.13
plugin-dir=/opt/repro-mysql84-native/mysql-8.4.13/lib/mysql/plugin
lc-messages-dir=/opt/repro-mysql84-native/mysql-8.4.13/share/mysql-8.4
datadir=/var/lib/repro-mysql84-native/data
socket=/run/repro-mysql84-native/mysql.sock
pid-file=/run/repro-mysql84-native/mysql.pid
tmpdir=/var/lib/repro-mysql84-native/tmp
skip-networking
mysqlx=OFF
skip-name-resolve
require-secure-transport=ON
local-infile=OFF
secure-file-priv=NULL
persisted-globals-load=OFF
event-scheduler=OFF
default-time-zone=+00:00
character-set-server=utf8mb4
collation-server=utf8mb4_0900_bin
sql-mode=ONLY_FULL_GROUP_BY,STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION

# Initial shared-host budget, subject to measured acceptance. Never auto-size.
innodb-dedicated-server=OFF
innodb-buffer-pool-size=4G
innodb-redo-log-capacity=2G
innodb-flush-log-at-trx-commit=1
sync-binlog=1
innodb-doublewrite=ON
max-connections=96
max-allowed-packet=268435456
innodb-lock-wait-timeout=5
lock-wait-timeout=60

server-id=64084
log-bin=/var/lib/repro-mysql84-native/data/binlog
binlog-format=ROW
binlog-row-image=FULL
gtid-mode=ON
enforce-gtid-consistency=ON
max-binlog-size=268435456
# No age-based purge can erase an unarchived gap. An archive-aware purge and
# free-space monitor are required before production use. This is not a size cap.
binlog-expire-logs-seconds=0
binlog-expire-logs-auto-purge=OFF

log-error=/var/log/repro-mysql84-native/error.log
log-error-verbosity=2
slow-query-log=ON
log-output=FILE
slow-query-log-file=/var/log/repro-mysql84-native/slow.log
long-query-time=1
