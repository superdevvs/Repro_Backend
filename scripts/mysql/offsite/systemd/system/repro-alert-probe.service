[Unit]
Description=RePro local alert detectors (no network)

[Service]
Type=oneshot
User=repro-backup
Group=repro-backup
SupplementaryGroups=adm
WorkingDirectory=/
StateDirectory=repro-alert-probe
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 -I -B /opt/repro-backup-tools/alert_probe.py run --plan /etc/repro-backup/alert-probe.json
TimeoutStartSec=50s
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
KillMode=control-group
TimeoutStopSec=10s
SendSIGKILL=yes
Restart=no
StandardOutput=journal
StandardError=journal
ProtectSystem=strict
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
ProtectHome=read-only
ReadWritePaths=/var/lib/repro-alert-inbox
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
CPUQuota=25%
MemoryMax=256M
TasksMax=32
SyslogIdentifier=repro-alert-probe
