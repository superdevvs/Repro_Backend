[Unit]
Description=RePro verify and archive one closed MySQL binary log batch
After=repro-binlog-rotate.service

[Service]
Type=oneshot
User=repro-backup
Group=repro-backup
SupplementaryGroups=repro-binlog-plan
WorkingDirectory=/var/lib/repro-backup
ExecStart=/usr/bin/python3 -I -B /opt/repro-backup-tools/archive_binlogs.py --plan /etc/repro-backup/closed-log-archive.json --plan-sha256 REVIEWED_ARCHIVE_PLAN_SHA256
TimeoutStartSec=110s
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
KillMode=control-group
TimeoutStopSec=10s
SendSIGKILL=yes
Restart=no
StandardOutput=journal
StandardError=journal
ProtectSystem=strict
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
ProtectHome=yes
ReadWritePaths=/var/lib/repro-backup
ReadOnlyPaths=/var/lib/repro-mysql84-native/data
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CPUQuota=50%
MemoryMax=512M
TasksMax=64
SyslogIdentifier=repro-binlog-archive
