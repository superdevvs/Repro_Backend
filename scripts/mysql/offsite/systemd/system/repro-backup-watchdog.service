[Unit]
Description=RePro database backup freshness watchdog
OnFailure=repro-backup-alert.service
OnFailureJobMode=replace

[Service]
Type=oneshot
User=repro-backup
Group=repro-backup
WorkingDirectory=/
ExecStart=/usr/bin/python3 -I -B /opt/repro-backup-tools/scheduled_backup.py check --plan /etc/repro-backup/plan.json
TimeoutStartSec=60s
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
KillMode=control-group
TimeoutStopSec=30s
SendSIGKILL=yes
Restart=no
StandardOutput=journal
StandardError=journal
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
PrivateNetwork=yes
CPUQuota=25%
MemoryMax=256M
TasksMax=32
RestrictAddressFamilies=AF_UNIX
SyslogIdentifier=repro-backup-watchdog
