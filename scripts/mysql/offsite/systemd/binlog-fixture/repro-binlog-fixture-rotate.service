[Unit]
Description=RePro fixture rotate one MySQL binary log
OnSuccess=repro-binlog-fixture-archive.service
OnFailure=repro-binlog-fixture-archive.service

[Service]
Type=oneshot
User=repro-binlog-rotate
Group=repro-binlog-rotate
SupplementaryGroups=repro-binlog-plan
StateDirectory=repro-binlog-fixture-rotation
StateDirectoryMode=0700
WorkingDirectory=/var/lib/repro-binlog-fixture-rotation
ExecStartPre=/usr/bin/mkdir -- /var/lib/repro-binlog-fixture-rotation/attempt.pending
ExecStartPre=/usr/bin/sync /var/lib/repro-binlog-fixture-rotation
ExecStart=/usr/bin/python3 -I -B /opt/repro-binlog-fixture-tools/rotation_attempt.py --plan /etc/repro-binlog-fixture/rotation.json --plan-sha256 REVIEWED_ROTATION_PLAN_SHA256
TimeoutStartSec=75s
TimeoutStopSec=10s
KillMode=control-group
Restart=no
UMask=0077
StandardOutput=journal
StandardError=journal
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
InaccessiblePaths=-/var/lib/repro-mysql84-binlog-fixture
