[Unit]
Description=RePro fixture verify and archive one closed MySQL binary log batch
After=repro-binlog-fixture-rotate.service

[Service]
Type=oneshot
User=repro-binlog-archive
Group=repro-binlog-archive
SupplementaryGroups=repro-binlog-plan
StateDirectory=repro-binlog-fixture-archive
StateDirectoryMode=0700
WorkingDirectory=/var/lib/repro-binlog-fixture-archive
ExecStart=/usr/bin/python3 -I -B /opt/repro-binlog-fixture-tools/archive_binlogs.py --plan /etc/repro-binlog-fixture/archive.json --plan-sha256 REVIEWED_ARCHIVE_PLAN_SHA256
TimeoutStartSec=110s
TimeoutStopSec=10s
KillMode=control-group
Restart=no
UMask=0077
StandardOutput=journal
StandardError=journal
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
InaccessiblePaths=-/var/lib/repro-binlog-fixture-rotation
