# Fixture only: requires an externally isolated user manager and prepared state.
# This profile does not provide the system profile's filesystem/network sandbox.
[Unit]
Description=RePro independent database backup freshness schedule

[Timer]
OnStartupSec=5m
OnUnitInactiveSec=5m
AccuracySec=30s
Unit=repro-backup-watchdog.service

[Install]
WantedBy=timers.target
