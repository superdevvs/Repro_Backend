# Fixture only: requires an externally isolated user manager and prepared state.
# This profile does not provide the system profile's filesystem/network sandbox.
[Unit]
Description=RePro database backup freshness watchdog
OnFailure=repro-backup-alert.service
OnFailureJobMode=replace

[Service]
Type=oneshot
WorkingDirectory=/
ExecStart=/usr/bin/python3 -I -B /opt/repro-backup-tools/scheduled_backup.py check --plan /etc/repro-backup/plan.json
TimeoutStartSec=60s
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
KillMode=control-group
TimeoutStopSec=30s
SendSIGKILL=yes
Restart=no
StandardOutput=journal
StandardError=journal
RestrictAddressFamilies=AF_UNIX
SyslogIdentifier=repro-backup-watchdog
